:"K4u9kL3nyg"},{"type":"outputs","id":"C6zXnsOASqn9SCcFExgZf","children":[],"key":"jfyFsyjVoj"}],"key":"qi4yetVajS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Area and Perimeter of quadrilateral patch","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pw8w7vmzSj"}],"identifier":"area-and-perimeter-of-quadrilateral-patch","label":"Area and Perimeter of quadrilateral patch","html_id":"area-and-perimeter-of-quadrilateral-patch","implicit":true,"key":"n2PEzwmncP"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We can make use of the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aon6O8gJ1a"},{"type":"inlineCode","value":"pyproj","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uLvNULLVWd"},{"type":"text","value":" Python package to calculate the area and perimeter of a patch formed by a list of latitude and longitude coordinates for an ellipsoid or a sphere.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GMUWRflrcV"}],"key":"N2AlHNzgeL"}],"key":"zCmOoFzb1H"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def area_of_polygon_ellps(poly_pts=None):\n    geod = Geod(ellps=\"WGS84\")\n    longitudes = [location_df.loc[pt, \"longitude\"] for pt in poly_pts]\n    latitudes = [location_df.loc[pt, \"latitude\"] for pt in poly_pts]\n    poly_area_m, poly_perimeter_m = geod.polygon_area_perimeter(longitudes, latitudes)\n    return abs(poly_area_m) * 1e-6, poly_perimeter_m/1000 # km^2 and km\n\ndef area_of_polygon_sphere(poly_pts=None):\n    geod = Geod(ellps=\"sphere\") # 'sphere': {'a': 6370997.0, 'b': 6370997.0, 'description': 'Normal Sphere (r=6370997)'\n    longitudes = [location_df.loc[pt, \"longitude\"] for pt in poly_pts]\n    latitudes = [location_df.loc[pt, \"latitude\"] for pt in poly_pts]\n    poly_area_m, poly_perimeter_m = geod.polygon_area_perimeter(longitudes, latitudes)\n    return abs(poly_area_m) * 1e-6, poly_perimeter_m/1000 # km^2 and km","key":"EBWuYTWEqH"},{"type":"outputs","id":"xouL0DwMpkZuuRtmWZ4yY","children":[],"key":"S11VjLxjxc"}],"key":"A6QRkwImpt"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s compare how area and perimeter vary based on whether you use an ellpsoid like  WGS-84 and a sphere. The changes will become more pronounced as you move further towards the poles.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mJP2nFrONu"}],"key":"tQUPMayh9Q"}],"key":"ClQc8FoYd5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"area_ellps, perimeter_ellps = area_of_polygon_ellps([\"boulder\", \"boston\",\n                                             \"arecibo\", \"houston\"])\narea_us, perimeter_us = area_of_polygon_sphere([\"boulder\", \"boston\",\n                                             \"arecibo\", \"houston\"])\nprint(f\"Area Ellipsoid   = {area_ellps} km^2\")\nprint(f\"Area Sphere = {area_us} km^2\")\nprint(f\"Perimeter Ellipsoid = {perimeter_ellps} km\")\nprint(f\"Perimeter Sphere = {perimeter_us} km\")\nprint(f\"Roughly {(area_ellps/509600000)*100:.2f}% of the Earth's Surface\")\nprint(f\"Roughly {(area_us/509600000)*100:.2f}% of the Earth's Surface\")","key":"oTCYicuhTd"},{"type":"outputs","id":"T-X5e4_LJ5MMjalilNZWy","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Area Ellipsoid   = 5342585.647699828 km^2\nArea Sphere = 5344606.94796931 km^2\nPerimeter Ellipsoid = 10171.738963248145 km\nPerimeter Sphere = 10170.504728302833 km\nRoughly 1.05% of the Earth's Surface\nRoughly 1.05% of the Earth's Surface\n"},"key":"TFy8JhIG1z"}],"key":"e9cGpEN6H3"}],"key":"m2wX4BRh3Y"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Area of Quadrilateral Patch","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TvbTkLpr6I"}],"identifier":"plot-area-of-quadrilateral-patch","label":"Plot Area of Quadrilateral Patch","html_id":"plot-area-of-quadrilateral-patch","implicit":true,"key":"ynW8PjiMRO"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Let’s see what spherical polygons looks like on a world map!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XncBQS3okS"}],"key":"RlSBaqnzQp"}],"key":"Gx2YotT3s6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def plot_area(pt_lst=None,\n                   lon_west=-180, lon_east=180,\n                   lat_south=-90, lat_north=90):\n    # Set up world map plot\n    fig = plt.subplots(figsize=(15, 10))\n    projection_map = ccrs.PlateCarree()\n    ax = plt.axes(projection=projection_map)\n    ax.set_extent([lon_west, lon_east, lat_south, lat_north], crs=projection_map)\n    ax.coastlines(color=\"black\")\n    ax.add_feature(cfeature.STATES, edgecolor=\"black\")\n\n   # plot points\n    longitudes = [location_df.loc[x, \"longitude\"] for x in pt_lst] # longitude\n    latitudes = [location_df.loc[y, \"latitude\"] for y in pt_lst] # latitude\n    plt.scatter(longitudes, latitudes, s=100, c=\"red\")\n    plt.fill(longitudes, latitudes, alpha=0.5)\n\n    # determine the area and perimeter\n    area_ellps, perimeter_ellps = area_of_polygon_ellps(pt_lst)\n    area_us, perimeter_us = area_of_polygon_sphere(pt_lst)\n    print(f\"Ellipsoid Area   = {area_ellps} km^2\")\n    print(f\"Sphere Area = {area_us} km^2\")\n    plt.title(f\"Roughly {(area_ellps/509600000)*100:.2f}% ({(area_us/509600000)*100:.2f}%) of the Earth's Surface\")\n    plt.show()","key":"S67RADj7Nz"},{"type":"outputs","id":"iSrvkwK8Sxer_3xboS-bz","children":[],"key":"hNmQWVkOrt"}],"key":"VUKTPfuMWy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_area([\"boulder\", \"boston\", \"greenwich\", \"cairo\", \"arecibo\", \"houston\"])","key":"iQ7HdifYoh"},{"type":"outputs","id":"uM_10r3B2SFpxZRr66O9u","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Ellipsoid Area   = 21872449.378265787 km^2\nSphere Area = 21896220.663299154 km^2\n"},"key":"kNgc7bY0wT"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"f2bf7a31439b8bf2a4a65bfb673f0ffb","path":"/great-circle-cookbook/build/f2bf7a31439b8bf2a4a65bfb673f0ffb.png"}}},"key":"PQETPm8R5d"}],"key":"mX8BqIDGj7"}],"key":"Wzda5f7YAN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_area([\"redwoods\", \"rockford\", \"boston\", \"houston\",], -130, -60, 20, 60)","key":"pVIOLKWfgL"},{"type":"outputs","id":"j4rzENKYAQ_9g-ZltlI46","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Ellipsoid Area   = 3150946.426714995 km^2\nSphere Area = 3149017.3086414044 km^2\n"},"key":"Od887WXX10"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"b99405d7a5060b2dff537ce2570a356e","path":"/great-circle-cookb