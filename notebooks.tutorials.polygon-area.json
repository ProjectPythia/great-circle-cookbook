alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"EnOJBFSZ3n"},{"type":"outputs","id":"zG44J4Pm55L1NcVEEZw9N","children":[],"key":"xFBVxRM9Ou"}],"key":"ZtbLm2kXkW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"zk4P6rdsk3"},{"type":"outputs","id":"p-GU633V_b3gkvPQIvs9V","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1a9cded1374b3f68299d0126091b6c1c","path":"/great-circle-cookbook/_public/1a9cded1374b3f68299d0126091b6c1c.png"}}},"key":"EXUW8Gr2zy"}],"key":"A0ylSEB0wb"}],"key":"uaQUcN3JZK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"GTuhmaA21e"},{"type":"outputs","id":"vNFpQ4Ulku1A47Uc6jNHm","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"290c28bc165998dcbd3392c5dd6569db","path":"/great-circle-cookbook/_public/290c28bc165998dcbd3392c5dd6569db.png"}}},"key":"cQwTkFNhkQ"}],"key":"vb6tEykMDm"}],"key":"CAKbrpDnvZ"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MReGsVKeim"}],"key":"qILGmEj5vn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","dep