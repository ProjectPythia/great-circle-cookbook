 latitudes, alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"YSXp3hR1Pr"},{"type":"outputs","id":"59Zk7-ZyowVJEhKHqLUxM","children":[],"key":"hkTpbarz8G"}],"key":"RTRdKedGBU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"kLecZ2sOs6"},{"type":"outputs","id":"Qip1f6Fq56BvWbbFJ62XK","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"4721ffece86c954945907a52c13fbf5a","path":"/great-circle-cookbook/build/4721ffece86c954945907a52c13fbf5a.png"}}},"key":"og4C4cheUp"}],"key":"QVwAYkTDE4"}],"key":"UrQBtt5uqS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"FsUC1M884B"},{"type":"outputs","id":"I8M2NlytJPawhXcLwqF5x","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"66f88ec18a31a35c802325fdf16956a0","path":"/great-circle-cookbook/build/66f88ec18a31a35c802325fdf16956a0.png"}}},"key":"dnKdAeSUeh"}],"key":"sPaysoncQq"}],"key":"FIAXIh7o9A"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SdNnbAbJOo"}],"key":"TmdZ7PdaBM"},{"type":"block","kind":"notebook-content","children":[{"type":"headi