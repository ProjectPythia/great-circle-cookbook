 latitudes, alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"ISK8FxbWGx"},{"type":"outputs","id":"iULy--1TGwMScfObOCJlG","children":[],"key":"AwmCAk45AB"}],"key":"Wm7TYddHKx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"pq7pmB6Hfe"},{"type":"outputs","id":"KNshws1ZgVMDCNs3wUhIp","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"4721ffece86c954945907a52c13fbf5a","path":"/great-circle-cookbook/build/4721ffece86c954945907a52c13fbf5a.png"}}},"key":"N4lyw3aJFb"}],"key":"Vt7DcGm7Wd"}],"key":"rTQgI77flQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"TSMdMtq8Jh"},{"type":"outputs","id":"F9h6bBnHBpuiKHm8-nWmu","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"66f88ec18a31a35c802325fdf16956a0","path":"/great-circle-cookbook/build/66f88ec18a31a35c802325fdf16956a0.png"}}},"key":"imig2dVAdH"}],"key":"A0W6gBhjkl"}],"key":"cy4iJH5RuZ"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KMaEYbtSAM"}],"key":"csn6mJ2d4m"},{"type":"block","kind":"notebook-content","children":[{"type":"headi