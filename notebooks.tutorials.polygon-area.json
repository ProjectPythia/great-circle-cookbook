, \"greenwich\"])","key":"GyPzOWSl6s"},{"type":"outputs","id":"NZrP8E4Ptkbyk6SKAI3tn","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Ellipsoid Area   = 914381.1786067616 km^2\nSphere Area = 954445.989927043 km^2\n"},"key":"AZgmevqVcA"},{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"232a603c42dd9fe7bfcf67aed1e0e0e4","path":"/great-circle-cookbook/build/232a603c42dd9fe7bfcf67aed1e0e0e4.png"}}},"key":"fOIHkzmzP1"}],"key":"n4HMNNXCNL"}],"key":"QkStfkQXyP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Determine if a given point is within a spherical polygon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IDBDyPn1FE"}],"identifier":"determine-if-a-given-point-is-within-a-spherical-polygon","label":"Determine if a given point is within a spherical polygon","html_id":"determine-if-a-given-point-is-within-a-spherical-polygon","implicit":true,"key":"b7rCS0XvP0"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Now that we have a spherical polygon, how can be determine if a new point lies within the area of the polygon? The ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aevmCd7Hhg"},{"type":"inlineCode","value":"shapely","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GsWioDxhUz"},{"type":"text","value":" Python package makes this quite easy, let’s give it a shot!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QDnCuqf9pu"}],"key":"RHVnTzvOdm"}],"key":"tuROmgAS47"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def polygon_contains_points(pt_lst=None, polygon_pts=None):\n    longitudes = [location_df.loc[pt, \"longitude\"] for pt in polygon_pts]\n    latitudes = [location_df.loc[pt, \"latitude\"] for pt in polygon_pts]\n    lat_lon_coords = tuple(zip(longitudes, latitudes))\n    # setup polygon\n    polygon = Polygon(lat_lon_coords)\n    # check if new point lies within the polygon\n    contains = np.vectorize(lambda pt: polygon.contains(Point((location_df.loc[pt, \"longitude\"],\n                                                               location_df.loc[pt, \"latitude\"]))))\n    contained_by_polygon = contains(np.array(pt_lst))\n    return contained_by_polygon","key":"tIfV8lTXmT"},{"type":"outputs","id":"FgL8SG7CPABv1X6pQ_rBL","children":[],"key":"IASue2mIOX"}],"key":"Y123NKqEOR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"polygon_contains_points([\"boulder\"], [\"redwoods\", \"boston\", \"houston\"])","key":"kNdzUP07z6"},{"type":"outputs","id":"F8eDFQGSg9dOohlm8MLjb","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":12,"metadata":{},"data":{"text/plain":{"content":"array([ True])","content_type":"text/plain"}}},"key":"LoIFrisNee"}],"key":"uoqMGejyKb"}],"key":"l5ubjUfYoF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot and See if New Point within Polygon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rmWDit8Ek0"}],"identifier":"plot-and-see-if-new-point-within-polygon","label":"Plot and See if New Point within Polygon","html_id":"plot-and-see-if-new-point-within-polygon","implicit":true,"key":"HlR5g9Snn1"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"On a map, it can be fairly intuitive to see if a point lies within a polygon or not. Let’s give it a shot!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xZDB5H3s4G"}],"key":"MeolFpZN9f"}],"key":"mAEeoGr2AQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def plot_polygon_pts(pt_lst=None, polygon_pts=None,\n                   lon_west=-180, lon_east=180,\n                   lat_south=-90, lat_north=90):\n    # Set up world map plot\n    fig = plt.subplots(figsize=(15, 10))\n    projection_map = ccrs.PlateCarree()\n    ax = plt.axes(projection=projection_map)\n    ax.set_extent([lon_west, lon_east, lat_south, lat_north], crs=projection_map)\n    ax.coastlines(color=\"black\")\n    ax.add_feature(cfeature.STATES, edgecolor=\"black\")\n\n    # plot polygon points\n    longitudes = [location_df.loc[x, \"longitude\"] for x in polygon_pts] # longitude\n    latitudes = [location_df.loc[y, \"latitude\"] for y in polygon_pts] # latitude\n    plt.scatter(longitudes, latitudes, s=50, c=\"blue\")\n    plt.fill(longitudes, latitudes, alpha=0.5)\n\n    # plot check points\n    pt_lst = np.array(pt_lst)\n    contains_pts = polygon_contains_points(pt_lst, polygon_pts)\n    longitudes = [location_df.loc[x, \"longitude\"] for x in pt_lst[contains_pts]] # longitude\n    latitudes = [location_df.loc[y, \"latitude\"] for y in pt_lst[contains_pts]] # latitude\n    plt.scatter(longitudes, latitudes, s=100, c=\"green\", label=\"Within Polygon\")\n    longitudes = [location_df.loc[x, \"longitude\"] for x in pt_lst[~contains_pts]] # longitude\n    latitudes = [location_df.loc[y, \"latitude\"] for y in pt_lst[~contains_pts]] # latitude\n    plt.scatter(longitudes, latitudes, s=100, c=\"red\", label=\"Not within Polygon\")\n\n    plt.legend(loc=\"lower left\")\n    plt.title(f\"Points contained within polygon = {pt_lst[contains_pts]}, not contained = {pt_lst[~contains_pts]}\")\n    plt.show()","key":"khbagg6jxF"},{"type":"outputs","id":"DRZKPMsmLUXs9XrhoAfVA","children":[],"key":"mvAKstNwzM"}],"key":"uLo2rB9ahT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"polygon_contains_points([\"boulder\"], [\"redwoods\", \"boston\", \"houston\"])","key":"PvpehVmmUt"},{"type":"outputs","id":"qyPm89ci_ocd4ZlnjMMUL","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":14,"metadata":{},"data":{"text/plain":{"content":"array([ True])","content_type":"text/plain"}}},"key":"LHN320AgGH"}],"key":"UPr8YCnomR"}],"key":"oI4IlZnTR1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_polygon_pts([\"boulder\"], [\"redwoods\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"VUIKQdyIbb"},{"type":"outputs","id":"MO6hM6iI9jBaaVyvF8og9","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"4cab7cab62ef92d072d12d2e465afd10","path":"/great-circle-cookbook/build/4cab7cab62ef92d072d12d2e465afd10.png"}}},"key":"ZoUPXclByo"}],"key":"T5GhRL4YQl"}],"key":"SR3XVg68ge"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"polygon_contains_points([\"cape canaveral\"], [\"redwoods\", \"boston\", \"houston\"])","key":"BIvmO0Qqt0"},{"type":"outputs","id":"gLSjbcHAli6iPjWFcxF3b","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":16,"metadata":{},"data":{"text/plain":{"content":"array([False])","content_type":"text/plain"}}},"key":"RfZp91TrRj"}],"key":"LTIAqZSqp1"}],"key":"wgZ3xLjBJq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_polygon_pts([\"cape canaveral\"], [\"redwoods\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"RNYpf3rL9c"},{"type":"outputs","id":"ax7n4uBLMGdZJ3eiq13Ma","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"fea107e9b0583f32cc09a43adfc66470","path":"/great-circle-cookbook/build/fea107e9b0583f32cc09a43adfc66470.png"}}},"key":"v0EW0QMWiC"}],"key":"Qoqfar9Fga"}],"key":"H8l6Tw2l7K"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_polygon_pts([\"boulder\", \"cape canaveral\"], [\"redwoods\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"zltmplPgu8"},{"type":"outputs","id":"o6t_i8rhw3MBQ9OlomTl9","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"590c138a0fb545f5b4770bf166cd9443","path":"/great-circle-cookbook/build/590c138a0fb545f5b4770bf166cd9443.png"}}},"key":"wX9dTlJcZX"}],"key":"Dr2elgo8wG"}],"key":"UxYvndhzmh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_polygon_pts([\"boulder\", \"redwoods\"], [\"rockford\", \"boston\", \"cape canaveral\"],\n               -130, -60, 20, 60)","key":"YZC5CAUGN6"},{"type":"outputs","id":"oYKpleExYci7g3qYqA5Nx","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"816310b05fb257144085b4e125052730","path":"/great-circle-cookbook/build/816310b05fb257144085b4e125052730.png"}}},"key":"j5cqV2my49"}],"key":"hTiXHvMJk6"}],"key":"yl2pepEJF5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Mean center of spherical polygon","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PgVJJUNXAt"}],"identifier":"mean-center-of-spherical-polygon","label":"Mean center of spherical polygon","html_id":"mean-center-of-spherical-polygon","implicit":true,"key":"B92Boveelz"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"A spherical polygon can have a fairly regular shape, especially as more points are added. But it is fairly simple using the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rAfIhwPuOJ"},{"type":"inlineCode","value":"shapley","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xiJJnFF8Sz"},{"type":"text","value":" Python package to determine the mean center.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"biHPP3TwLO"}],"key":"uSwBdnkqDY"}],"key":"UaD5EGVOIl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def polygon_centroid(polygon_pts=None):\n    longitudes = [location_df.loc[x, \"longitude\"] for x in polygon_pts]\n    latitudes = [location_df.loc[y, \"latitude\"] for y in polygon_pts]\n    lat_lon_coords = tuple(zip(longitudes, latitudes))\n    polygon = Polygon(lat_lon_coords)\n    return (polygon.centroid.y, polygon.centroid.x)","key":"e9E2cx4Wv8"},{"type":"outputs","id":"horxjJwjCFIky8a8CzEQo","children":[],"key":"UViWFQfKSv"}],"key":"BGuCrThIQs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"polygon_centroid([\"boulder\", \"boston\", \"houston\"])","key":"VBnS03diA6"},{"type":"outputs","id":"tSgtDTs7eB1eCtAzIL6ZB","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"execute_result","execution_count":21,"metadata":{},"data":{"text/plain":{"content":"(37.30896666666666, -90.47586666666665)","content_type":"text/plain"}}},"key":"FL7MAOlQn5"}],"key":"cB4YUChCos"}],"key":"DGXYKHd5p5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Centroid","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Vkbcv10G0z"}],"identifier":"plot-centroid","label":"Plot Centroid","html_id":"plot-centroid","implicit":true,"key":"xAFe4Qnuv1"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The center of a polygon can be fairly apparently on a map, let’s give it a look!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"g7SAKgiztx"}],"key":"NIHiHScgkb"}],"key":"bTPtAcFOOu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def plot_centroid(polygon_pts=None,\n                   lon_west=-180, lon_east=180,\n                   lat_south=-90, lat_north=90):\n    # Set up world map plot\n    fig = plt.subplots(figsize=(15, 10))\n    projection_map = ccrs.PlateCarree()\n    ax = plt.axes(projection=projection_map)\n    ax.set_extent([lon_west, lon_east, lat_south, lat_north], crs=projection_map)\n    ax.coastlines(color=\"black\")\n    ax.add_feature(cfeature.STATES, edgecolor=\"black\")\n\n   # plot polygon points\n    longitudes = [location_df.loc[x, \"longitude\"] for x in polygon_pts] # longitude\n    latitudes = [location_df.loc[y, \"latitude\"] for y in polygon_pts] # latitude\n    plt.scatter(longitudes, latitudes, s=50, c=\"blue\")\n    plt.fill(longitudes, latitudes, alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"DNxbZKkOHi"},{"type":"outputs","id":"Emswj7r_mwL6i6h6i3Lp-","children":[],"key":"LOqZXmfyHS"}],"key":"p3RAr6UTwi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"glqFZfASwa"},{"type":"outputs","id":"M-qJGNfoOe1kzybqIgoGo","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1a9cded1374b3f68299d0126091b6c1c","path":"/great-circle-cookbook/build/1a9cded1374b3f68299d0126091b6c1c.png"}}},"key":"Tnm8DLvTO5"}],"key":"H8WkcDJHjk"}],"key":"IcNEERbnbt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"kFLNmTVCzy"},{"type":"outputs","id":"19ZTZkRauUBaDq46fg2PK","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"290c28bc165998dcbd3392c5dd6569db","path":"/great-circle-cookbook/build/290c28bc165998dcbd3392c5dd6569db.png"}}},"key":"xbEqrmhtOC"}],"key":"kQWD5Zazud"}],"key":"V3wWvjBTrS"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DU1lMzBfxE"}],"key":"rE947X9iPK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":