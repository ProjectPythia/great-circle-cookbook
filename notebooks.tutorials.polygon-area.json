 latitudes, alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"KZs2maCu0i"},{"type":"outputs","id":"qDT_RVllFuDmb4orzkN7K","children":[],"key":"dumxYKspnj"}],"key":"vsdHjRCOBd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"RUDFMX1n1C"},{"type":"outputs","id":"JOnXL2F1ZZGPqLMwFXRHl","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"4721ffece86c954945907a52c13fbf5a","path":"/great-circle-cookbook/build/4721ffece86c954945907a52c13fbf5a.png"}}},"key":"hO1DdD2BLl"}],"key":"KdARemnufm"}],"key":"AVzxxnPYij"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"RqHvRVqxxd"},{"type":"outputs","id":"xVicJ3p3IDXgQnokdKq-O","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"66f88ec18a31a35c802325fdf16956a0","path":"/great-circle-cookbook/build/66f88ec18a31a35c802325fdf16956a0.png"}}},"key":"N6pxY3aMph"}],"key":"z4SYwd1EQD"}],"key":"JA16CNdnla"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jeeWQzwCBV"}],"key":"eIH4kLkQ2n"},{"type":"block","kind":"notebook-content","children":[{"type":"headi