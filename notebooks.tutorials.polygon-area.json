alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"XK2ArOLZCd"},{"type":"outputs","id":"FSYj2FxNdFjXZbEyHOUvH","children":[],"key":"FDdVXlHkIO"}],"key":"AojsatNz3D"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"IAtrRIZpcA"},{"type":"outputs","id":"S0J6RrQMn8iG31lcPqlKJ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1a9cded1374b3f68299d0126091b6c1c","path":"/great-circle-cookbook/_public/1a9cded1374b3f68299d0126091b6c1c.png"}}},"key":"si6AXxezW1"}],"key":"Lkjfe0W58a"}],"key":"D6QhysjBwp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"fvSXvkj5h2"},{"type":"outputs","id":"y-yTnwtiqtZCLq4v1oaD-","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"290c28bc165998dcbd3392c5dd6569db","path":"/great-circle-cookbook/_public/290c28bc165998dcbd3392c5dd6569db.png"}}},"key":"Okov7VpbF6"}],"key":"Th1NXAYnfv"}],"key":"kgUwQ3ONgz"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pRqjC4IXvr"}],"key":"mE9DVvTE7G"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","dep