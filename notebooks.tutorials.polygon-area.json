alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"iiuuWl4Ekz"},{"type":"outputs","id":"_vmBaiObi-IjU41bjYxKA","children":[],"key":"KiltfqpySC"}],"key":"Y32kwHHpnt"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"I7qkzGxCJS"},{"type":"outputs","id":"xoQ0u2eROVucrOakcfI6w","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1a9cded1374b3f68299d0126091b6c1c","path":"/great-circle-cookbook/_public/1a9cded1374b3f68299d0126091b6c1c.png"}}},"key":"CCaXeHXj0V"}],"key":"hVPQHMsaJG"}],"key":"tQAgEFmhNb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"qNZjryPrWS"},{"type":"outputs","id":"ak0bkD7I2FzkXPi7-lilF","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"290c28bc165998dcbd3392c5dd6569db","path":"/great-circle-cookbook/_public/290c28bc165998dcbd3392c5dd6569db.png"}}},"key":"Jceif0BcFX"}],"key":"WW5vFq2kJ0"}],"key":"fEufNRBcrE"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q46DeXReCa"}],"key":"nQlld8Psyj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","dep