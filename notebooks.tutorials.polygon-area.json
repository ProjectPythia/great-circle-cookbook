 latitudes, alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"xbP8i573GE"},{"type":"outputs","id":"fEj6EmgwFkxfbIyJ1tlPp","children":[],"key":"dBdr1weFji"}],"key":"o9a9eLSRU6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"MGJ4qEBw2y"},{"type":"outputs","id":"3E_J7yfRCE1EVqBGIagQw","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"4721ffece86c954945907a52c13fbf5a","path":"/great-circle-cookbook/build/4721ffece86c954945907a52c13fbf5a.png"}}},"key":"CXfs0LasT9"}],"key":"H6GkFE3PZd"}],"key":"AuHa4XsLZv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"mIWq8knWJF"},{"type":"outputs","id":"u0P9ttnz-0WirbNE4EZ6D","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"66f88ec18a31a35c802325fdf16956a0","path":"/great-circle-cookbook/build/66f88ec18a31a35c802325fdf16956a0.png"}}},"key":"x0j8OlWeeW"}],"key":"DnqNlG8mOC"}],"key":"ItP5wt6mGZ"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sEWGJ5PsXR"}],"key":"TyLgwihRR6"},{"type":"block","kind":"notebook-content","children":[{"type":"headi