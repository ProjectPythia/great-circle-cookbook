alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"guAW1N5DHw"},{"type":"outputs","id":"253aJjM0WF0f86gebkNZA","children":[],"key":"j6hYo7GZEi"}],"key":"wjn4pmx7aU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"r84oxYa98l"},{"type":"outputs","id":"YCeQ9bRxn_s5Jp7FRg0FZ","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1a9cded1374b3f68299d0126091b6c1c","path":"/great-circle-cookbook/_public/1a9cded1374b3f68299d0126091b6c1c.png"}}},"key":"VowGpl2WVF"}],"key":"t8RHbPSiMO"}],"key":"Siuh10RqqJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"KKYRlbqaUz"},{"type":"outputs","id":"eGUagZHP56EwLWybX7HTk","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"290c28bc165998dcbd3392c5dd6569db","path":"/great-circle-cookbook/_public/290c28bc165998dcbd3392c5dd6569db.png"}}},"key":"rECByld6Zw"}],"key":"pSnTqjtfLk"}],"key":"COPNHNcmbp"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yGjOynpUUN"}],"key":"FqJ9BpX2FX"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","dep