 latitudes, alpha=0.5)\n\n    # plot check point\n    centeroid = polygon_centroid(polygon_pts)\n    plt.scatter(centeroid[1], centeroid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"dzawiIUn9D"},{"type":"outputs","id":"rn3uwVQAGBSMCGDefh2D9","children":[],"key":"YKgxv6amS1"}],"key":"DmCHb0vF47"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"ed5IqfDpyK"},{"type":"outputs","id":"udS_NKH46Ld8PdGeEemq9","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"4721ffece86c954945907a52c13fbf5a","path":"/great-circle-cookbook/build/4721ffece86c954945907a52c13fbf5a.png"}}},"key":"UbaWadFW5X"}],"key":"rHZMNxeU6V"}],"key":"lpcrjKbtmL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"MD2ZznJrZZ"},{"type":"outputs","id":"axYzaHzC5-Oi3HIbr6sSw","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"66f88ec18a31a35c802325fdf16956a0","path":"/great-circle-cookbook/build/66f88ec18a31a35c802325fdf16956a0.png"}}},"key":"J21i9bs0aD"}],"key":"Tx0h3PgyGe"}],"key":"suTOv5oYvd"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UHf29vzbBt"}],"key":"LWuMmeWjFS"},{"type":"block","kind":"notebook-content","children":[{"type":"headi