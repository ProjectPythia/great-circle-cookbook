id[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"ah0EPbJYvU"},{"type":"output","id":"6lVI3kEuNpTQkzouDN-55","data":[],"key":"UPAVVporFs"}],"key":"ov7352XsK1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"NQ8FXEcWCQ"},{"type":"output","id":"4TsxIR_-cMTn9_eHzBk-2","data":[{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"106c9ca374f56f105a410f6f96c6a480","path":"/great-circle-cookbook/build/106c9ca374f56f105a410f6f96c6a480.png"}}}],"key":"XH3yTewvYU"}],"key":"s60v2JQGPl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"sTGx8UXWWP"},{"type":"output","id":"zbW1oXPPVbCbTdeHJS30O","data":[{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"7c33a4b69673576d6b8b8305ff95be15","path":"/great-circle-cookbook/build/7c33a4b69673576d6b8b8305ff95be15.png"}}}],"key":"xG7Cp013Uj"}],"key":"XpPUSv1fLH"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DuxuHcHak9"}],"key":"iXMOJPllXP"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oLjKdVIpiL"}],"identifier":"summary","label":"Summary","html_id":"summary