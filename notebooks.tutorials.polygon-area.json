roid[0], s=100, c=\"red\")\n    plt.title(f\"Centroid = {centeroid}\")\n    plt.show()","key":"yJ7qaKjzdg"},{"type":"output","id":"B1SV3DbiAkqvSkLkUIDRb","data":[],"key":"qlcdrpltNQ"}],"key":"pj2AjTjPRb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"boulder\", \"boston\", \"houston\"],\n               -130, -60, 20, 60)","key":"ISAkbFERxC"},{"type":"output","id":"6gJne3N7DHfJuVHXT4sbP","data":[{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"f352400011bffb56ce74638ea60ab2ad","path":"/great-circle-cookbook/build/f352400011bffb56ce74638ea60ab2ad.png"}}}],"key":"LYRFlUe1Ti"}],"key":"Uhh5yLpKve"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plot_centroid([\"redwoods\", \"boulder\", \"cape canaveral\", \"houston\"],\n               -130, -60, 20, 60)","key":"djzWgiYji3"},{"type":"output","id":"G35Stan1NCwq6pFDmmwGc","data":[{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1000 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"2a07c852f9c61ef27b170cf98364e94e","path":"/great-circle-cookbook/build/2a07c852f9c61ef27b170cf98364e94e.png"}}}],"key":"IJgRGLVS0I"}],"key":"g2ZPPUlSy2"},{"type":"block","kind":"notebook-content","children":[{"type":"thematicBreak","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PM1ALPJCHI"}],"key":"YnRpqqwSap"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Qy8JPEfARO"}],"identifier":"summary","label":"Summary","html_id":"summa